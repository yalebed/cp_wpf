<Window x:Class="RentalCarApplication.View.CompleteOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Завершение заказа"
        Width="860"
        Height="640"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Background="WhiteSmoke" CornerRadius="22" BorderBrush="{DynamicResource PrimaryHueDarkBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="86"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="20,20,0,0">
                <Grid Margin="24,0,24,0">
                    <TextBlock Text="Завершение заказа"
                               Foreground="White"
                               FontSize="22"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <Button Width="48"
                            Height="48"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CloseButton_Click"
                            Style="{StaticResource MaterialDesignFloatingActionDarkButton}">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,18,26,16">
                    <TextBlock Text="{Binding OrderSummary}"
                               FontSize="17"
                               Foreground="DarkSlateGray"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Чтобы завершить аренду, прикрепите фото автомобиля с нескольких ракурсов."
                               Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="DimGray"
                               TextWrapping="Wrap"/>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,10,0" Background="White" CornerRadius="18" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Фото спереди" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center"/>
                                <Button Margin="0,14,0,0"
                                        Command="{Binding UploadFrontPhotoCommand}"
                                        Style="{StaticResource MaterialDesignRaisedDarkButton}"
                                        materialDesign:ButtonAssist.CornerRadius="10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ImagePlus" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Прикрепить"/>
                                    </StackPanel>
                                </Button>
                                <Image Source="{Binding FrontPhotoPath}" Height="170" Stretch="Uniform" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="5,0" Background="White" CornerRadius="18" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Фото сзади" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center"/>
                                <Button Margin="0,14,0,0"
                                        Command="{Binding UploadRearPhotoCommand}"
                                        Style="{StaticResource MaterialDesignRaisedDarkButton}"
                                        materialDesign:ButtonAssist.CornerRadius="10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ImagePlus" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Прикрепить"/>
                                    </StackPanel>
                                </Button>
                                <Image Source="{Binding RearPhotoPath}" Height="170" Stretch="Uniform" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Margin="10,0,0,0" Background="White" CornerRadius="18" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Фото сбоку" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center"/>
                                <Button Margin="0,14,0,0"
                                        Command="{Binding UploadSidePhotoCommand}"
                                        Style="{StaticResource MaterialDesignRaisedDarkButton}"
                                        materialDesign:ButtonAssist.CornerRadius="10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ImagePlus" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Прикрепить"/>
                                    </StackPanel>
                                </Button>
                                <Image Source="{Binding SidePhotoPath}" Height="170" Stretch="Uniform" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="18" Background="WhiteSmoke" CornerRadius="0,0,20,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Width="180"
                            Margin="0,0,12,0"
                            Click="CompleteButton_Click"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}"
                            materialDesign:ButtonAssist.CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckBold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Завершить заказ"/>
                        </StackPanel>
                    </Button>
                    <Button Width="140"
                            Click="CloseButton_Click"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}"
                            materialDesign:ButtonAssist.CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Отмена"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
