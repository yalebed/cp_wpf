<Window x:Class="RentalCarApplication.View.CarAvailabilityCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="&#x041A;&#x0430;&#x043B;&#x0435;&#x043D;&#x0434;&#x0430;&#x0440;&#x044C; &#x0437;&#x0430;&#x043D;&#x044F;&#x0442;&#x043E;&#x0441;&#x0442;&#x0438;"
        Width="800"
        Height="560"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Background="Transparent"
          materialDesign:ShadowAssist.ShadowDepth="Depth4">
        <Border Background="White"
                CornerRadius="22"
                Margin="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="88"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource PrimaryHueMidBrush}"
                        CornerRadius="22,22,0,0">
                    <Grid MouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#x041A;&#x0430;&#x043B;&#x0435;&#x043D;&#x0434;&#x0430;&#x0440;&#x044C; &#x0437;&#x0430;&#x043D;&#x044F;&#x0442;&#x043E;&#x0441;&#x0442;&#x0438;"
                                       FontSize="24"
                                       FontWeight="Regular"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtCarTitle"
                                       FontSize="15"
                                       Foreground="White"
                                       Opacity="0.95"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Width="40"
                                Height="40"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0"
                                Background="White"
                                Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CloseButton_Click"
                                Style="{StaticResource MaterialDesignFloatingActionDarkButton}">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0"
                            Background="#F6F6F6"
                            CornerRadius="18"
                            Padding="14"
                            Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="&#x0417;&#x0430;&#x043D;&#x044F;&#x0442;&#x044B;&#x0435; &#x0434;&#x0430;&#x0442;&#x044B;"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>
                            <Calendar x:Name="calendarOccupancy"/>
                            <TextBlock Text="&#x0421;&#x0435;&#x0440;&#x044B;&#x043C; &#x043E;&#x0442;&#x043C;&#x0435;&#x0447;&#x0435;&#x043D;&#x044B; &#x0434;&#x043D;&#x0438;, &#x043A;&#x043E;&#x0433;&#x0434;&#x0430; &#x0430;&#x0432;&#x0442;&#x043E; &#x043D;&#x0435;&#x0434;&#x043E;&#x0441;&#x0442;&#x0443;&#x043F;&#x0435;&#x043D; &#x043A; &#x0431;&#x0440;&#x043E;&#x043D;&#x0438;&#x0440;&#x043E;&#x0432;&#x0430;&#x043D;&#x0438;&#x044E;."
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Foreground="DimGray"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="#F6F6F6"
                            CornerRadius="18"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="&#x041F;&#x0435;&#x0440;&#x0438;&#x043E;&#x0434;&#x044B; &#x0437;&#x0430;&#x043D;&#x044F;&#x0442;&#x043E;&#x0441;&#x0442;&#x0438;"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <Grid Grid.Row="1">
                                <ScrollViewer x:Name="periodsScroll"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="periodsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White"
                                                        CornerRadius="12"
                                                        Padding="10"
                                                        Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding PeriodText}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock x:Name="txtNoPeriods"
                                           Text="&#x0414;&#x043B;&#x044F; &#x044D;&#x0442;&#x043E;&#x0433;&#x043E; &#x0430;&#x0432;&#x0442;&#x043E; &#x043F;&#x043E;&#x043A;&#x0430; &#x043D;&#x0435;&#x0442; &#x0430;&#x043A;&#x0442;&#x0438;&#x0432;&#x043D;&#x044B;&#x0445; &#x0438;&#x043B;&#x0438; &#x043E;&#x0436;&#x0438;&#x0434;&#x0430;&#x044E;&#x0449;&#x0438;&#x0445; &#x0437;&#x0430;&#x043A;&#x0430;&#x0437;&#x043E;&#x0432;."
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontSize="14"
                                           Foreground="DimGray"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
