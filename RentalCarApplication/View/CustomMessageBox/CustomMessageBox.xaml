<Window x:Class="RentalCarApplication.View.CustomMessageBox.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="MessageBoxWindow"
        Width="520"
        MinHeight="220"
        MaxHeight="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="White"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="10"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid materialDesign:ShadowAssist.ShadowDepth="Depth5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card x:Name="cardHeader"
                             Grid.Row="0"
                             Padding="16,12"
                             Margin="0"
                             materialDesign:ShadowAssist.ShadowDepth="Depth2"
                             Background="{DynamicResource PrimaryHueMidBrush}"
                             Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
                             Visibility="Visible">
            <Grid>
                <TextBlock x:Name="txtTitle"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{DynamicResource MaterialDesignTitleTextBlock}"
                           FontSize="20">Message Title</TextBlock>
                <Button x:Name="btnClose"
                        Click="btnClose_Click"
                        Width="35"
                        Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="White"
                        Foreground="{DynamicResource PrimaryHueDarkBrush}"
                        Style="{StaticResource MaterialDesignFloatingActionDarkButton}">
                    <materialDesign:PackIcon Kind="Close" />
                </Button>
            </Grid>
        </materialDesign:Card>

        <Border Grid.Row="1" Background="Honeydew">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon x:Name="ConfirmationIcon"
                                             Grid.Column="0"
                                             Kind="HelpCircleOutline"
                                             Width="40"
                                             Height="40"
                                             Margin="0,4,16,0"
                                             Foreground="DarkRed"
                                             VerticalAlignment="Top"
                                             Visibility="Collapsed" />
                    <materialDesign:PackIcon x:Name="InfoIcon"
                                             Grid.Column="0"
                                             Kind="InformationOutline"
                                             Width="40"
                                             Height="40"
                                             Margin="0,4,16,0"
                                             Foreground="Gold"
                                             VerticalAlignment="Top"
                                             Visibility="Collapsed" />
                    <materialDesign:PackIcon x:Name="SuccessIcon"
                                             Grid.Column="0"
                                             Kind="CheckCircleOutline"
                                             Width="40"
                                             Height="40"
                                             Margin="0,4,16,0"
                                             Foreground="Green"
                                             VerticalAlignment="Top"
                                             Visibility="Collapsed" />
                    <materialDesign:PackIcon x:Name="ErrorIcon"
                                             Grid.Column="0"
                                             Kind="CloseCircleOutline"
                                             Width="40"
                                             Height="40"
                                             Margin="0,4,16,0"
                                             Foreground="Red"
                                             VerticalAlignment="Top"
                                             Visibility="Collapsed" />

                    <ScrollViewer Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="260">
                        <StackPanel>
                            <TextBlock x:Name="txtMessage"
                                       MaxWidth="400"
                                       Margin="0,0,0,8"
                                       FontSize="18"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="txtActionLink"
                                       Visibility="Collapsed"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                       FontSize="15"
                                       TextDecorations="Underline"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="txtActionLink_MouseLeftButtonUp" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnOk"
                            Click="btnOk_Click"
                            Grid.Column="1"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="5"
                            Width="100"
                            Content="OK"
                            ToolTip="Ok"/>
                    <Button x:Name="btnCancel"
                            Click="btnCancel_Click"
                            Grid.Column="2"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="5"
                            Width="100"
                            Content="Cancel"
                            ToolTip="Cancel"/>
                    <Button x:Name="btnYes"
                            Click="btnYes_Click"
                            Grid.Column="1"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="5"
                            Width="100"
                            Content="Да"
                            ToolTip="Да"/>
                    <Button x:Name="btnNo"
                            Click="btnNo_Click"
                            Grid.Column="2"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="5"
                            Width="100"
                            Content="Нет"
                            ToolTip="Нет"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

