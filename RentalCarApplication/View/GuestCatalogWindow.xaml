<UserControl x:Class="RentalCarApplication.View.GuestCatalogWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource PrimaryHueMidBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Background="{DynamicResource PrimaryHueDarkBrush}" Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="24 16" Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CarSaloon" Width="32" Height="32" Margin="0 0 12 0" Foreground="White"/>
                <StackPanel>
                    <TextBlock Text="Каталог автомобилей"
                               FontSize="22"
                               Foreground="White"
                               FontWeight="Medium"/>
                    <TextBlock Text="Просмотр автомобилей компании без регистрации"
                               FontSize="13"
                               Foreground="WhiteSmoke"/>
                </StackPanel>
            </StackPanel>

            <WrapPanel Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="0 0 24 0"
                       ItemHeight="46">
                <Button Command="{Binding NavigateToLoginCommand}"
                        Width="112"
                        Height="38"
                        Margin="0 0 10 0"
                        Padding="10 0"
                        Background="{DynamicResource AppCardBrush}"
                        Foreground="{DynamicResource PrimaryHueDarkBrush}"
                        FontWeight="SemiBold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Login"
                                                 Width="22"
                                                 Height="22"
                                                 Margin="0 0 8 0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                        <TextBlock Text="Войти"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding NavigateToRegisterCommand}"
                        Width="144"
                        Height="38"
                        Padding="10 0"
                        Background="{DynamicResource AppCardBrush}"
                        Foreground="{DynamicResource PrimaryHueDarkBrush}"
                        FontWeight="SemiBold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountPlusOutline"
                                                 Width="22"
                                                 Height="22"
                                                 Margin="0 0 8 0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                        <TextBlock Text="Регистрация"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="12 0 12 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <TextBlock Text="Поиск"
                           HorizontalAlignment="Center"
                           Foreground="WhiteSmoke"
                           Margin="0 6 0 8"
                           FontSize="20"
                           FontWeight="Medium"/>

                <Border CornerRadius="14"
                        Background="{DynamicResource AppCardBrush}"
                        Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="66"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Text="Марка" VerticalAlignment="Center" FontSize="15" Margin="4 10 10 10"/>
                        <TextBlock Grid.Column="0" Grid.Row="1" Text="Кузов" VerticalAlignment="Center" FontSize="15" Margin="4 10 10 10"/>
                        <TextBlock Grid.Column="0" Grid.Row="2" Text="Сидения" VerticalAlignment="Center" FontSize="15" Margin="4 10 10 10"/>
                        <TextBlock Grid.Column="0" Grid.Row="3" Text="КПП" VerticalAlignment="Center" FontSize="15" Margin="4 10 10 10"/>
                        <TextBlock Grid.Column="0" Grid.Row="4" Text="Цена" VerticalAlignment="Center" FontSize="15" Margin="4 10 10 10"/>

                        <ComboBox Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" FontSize="15" Margin="0 4 0 4" Text="{Binding SearchBrand}" ItemsSource="{Binding SearchBrandList}"/>
                        <ComboBox Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SearchBodyType}" FontSize="12" Margin="0 4 0 4">
                            <ComboBoxItem Content="Седан"/>
                            <ComboBoxItem Content="Универсал"/>
                            <ComboBoxItem Content="Купе"/>
                            <ComboBoxItem Content="Бус"/>
                            <ComboBoxItem Content="Спорт"/>
                            <ComboBoxItem Content="Вен"/>
                            <ComboBoxItem Content="Джип"/>
                        </ComboBox>
                        <ComboBox Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SearchSeats}" FontSize="12" Margin="0 4 0 4">
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="9"/>
                        </ComboBox>
                        <ComboBox Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding SearchGearBox}" FontSize="12" Margin="0 4 0 4">
                            <ComboBoxItem Content="АКПП"/>
                            <ComboBoxItem Content="МКПП"/>
                        </ComboBox>

                        <TextBox Grid.Column="1" Grid.Row="4" FontSize="15" Margin="0 4 8 4" Text="{Binding SearchPriceFrom}" materialDesign:HintAssist.Hint="От"/>
                        <TextBox Grid.Column="2" Grid.Row="4" FontSize="15" Margin="0 4 0 4" Text="{Binding SearchPriceTo}" materialDesign:HintAssist.Hint="До"/>

                        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="5" Margin="0 8 0 0">
                            <Button Style="{StaticResource MaterialDesignRaisedDarkButton}"
                                    Command="{Binding SearchCarCommand}"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    Margin="0 8 0 0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Search" Margin="0 0 5 0"/>
                                    <TextBlock Text="Поиск"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ClearSearchFieldsCommand}"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    Margin="0 8 0 0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cancel" Margin="0 0 5 0"/>
                                    <TextBlock Text="Очистить"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0 12 0 0"
                        Padding="12"
                        CornerRadius="10"
                        Background="#14374151"
                        BorderBrush="#33374151"
                        BorderThickness="1">
                    <TextBlock Text="Оформление заказа доступно после входа в аккаунт."
                               Foreground="WhiteSmoke"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <Border Grid.Column="2"
                    Padding="40 6 4 6"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                    BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <ItemsControl ItemsSource="{Binding CarList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="320"
                                        Margin="6"
                                        Background="{DynamicResource AppCardBrush}"
                                        BorderBrush="{DynamicResource AppCardBorderBrush}"
                                        BorderThickness="1"
                                        Padding="40 30" 
                                        CornerRadius="12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16"
                                                          ShadowDepth="3"
                                                          Opacity="0.18"
                                                          Color="#111827"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Image Source="{Binding PhotoPath}"
                                           Width="250"
                                           Height="150"
                                           HorizontalAlignment="Center"
                                           Stretch="UniformToFill"
                                           Margin="0 0 0 16"/>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Brand}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Margin="0 5 0 10"/>

                                        <Grid Grid.Row="2" Margin="2 8 2 0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Column="0" Grid.Row="0" Margin="0 0 0 10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Номер: " FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CarId}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Grid.Column="2" Grid.Row="0" Margin="20 0 0 10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="КПП: " FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding GearBox}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Grid Grid.Column="0" Grid.Row="1" Margin="0 0 0 10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Кузов:" FontSize="14" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding BodyType}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Top"
                                                           TextWrapping="Wrap"
                                                           Margin="3 0 0 0"/>   
                                            </Grid>
                                            <Grid Grid.Column="2" Grid.Row="1" Margin="20 0 0 10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Объем:" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding EngineCapacity}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3 0 0 0"/>
                                            </Grid>

                                            <Grid Grid.Column="0" Grid.Row="2" Margin="0 0 0 10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Сидения:" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Seats}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3 0 0 0"/>
                                            </Grid>
                                            <Grid Grid.Column="2" Grid.Row="2" Margin="20 0 0 10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Расход:" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Consumption}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3 0 0 0"/>
                                            </Grid>

                                            <Grid Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3" Margin="0 4 0 0">
                                                <TextBlock Text="{Binding Price, StringFormat={}{0} BYN}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
